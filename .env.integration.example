# Configuração exclusiva dos testes de integração em compose.integration.yml.
# As credenciais são descartáveis e não devem ser usadas em outros ambientes.

# Conexão padrão usada quando IT_DATABASE não seleciona um banco específico.
DB_DEFAULT_CONNECTION=postgresql

# PostgreSQL
# O contêiner publica a porta 5432 na porta local 55432.
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=55432
POSTGRESQL_USER=mindqa
POSTGRESQL_PASS=Mindqa_Test_123!
POSTGRESQL_NAME=mindqa
POSTGRESQL_LOGIN_TIMEOUT_SECONDS=5

# MySQL
# O contêiner publica a porta 3306 na porta local 53306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=53306
MYSQL_USER=root
MYSQL_PASS=Mindqa_Test_123!
MYSQL_NAME=mindqa
MYSQL_LOGIN_TIMEOUT_SECONDS=5

# SQL Server
# O contêiner publica a porta 1433 na porta local 51433. O certificado é
# autoassinado porque esta conexão existe somente no ambiente local de testes.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=51433
SQLSERVER_USER=sa
SQLSERVER_PASS=Mindqa_Test_123!
SQLSERVER_NAME=mindqa
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_LOGIN_TIMEOUT_SECONDS=5

# Oracle Database Free
# O contêiner publica a porta 1521 na porta local 51521 e usa FREEPDB1 como
# service name da pluggable database criada pela imagem.
ORACLE_HOST=127.0.0.1
ORACLE_PORT=51521
ORACLE_USER=mindqa
ORACLE_PASS=Mindqa_Test_123!
ORACLE_NAME=FREEPDB1
ORACLE_LOGIN_TIMEOUT_SECONDS=5
